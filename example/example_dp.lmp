variable inname string "in"
variable basename string "example_dp"

units         metal
atom_style    charge
read_data     ${inname}.data

pair_style   deepmd graph.pb
pair_coeff    * * 

neighbor      2.5 bin
neigh_modify  every 10 delay 0 check no

thermo        1000
thermo_style  custom step temp press etotal density
dump          traj all custom 5000 ${basename}.lammpstrj id type x y z
log           ${basename}.log

velocity        all create 3000 12345 mom yes rot yes dist gaussian

fix             1 all nve
fix             2 all temp/berendsen 4000 4000 500

timestep      0.0001
run           10000

write_data    ${basename}.data

