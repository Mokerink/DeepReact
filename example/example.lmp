variable inname string "in"
variable basename string "example"

units         real
atom_style    charge
read_data     ${inname}.data

pair_style    reax/c NULL
pair_coeff    * * ffield.reax.cho C H O

fix           reax_qeq all qeq/reax 50 0.0 8.0 1e-4 reax/c
fix           reax_out_species all reax/c/species 100 50 5000 ${basename}.species.out cutoff 1 1 0.55 
fix           reax_out_bonds all reax/c/bonds 5000 ${basename}.bonds.out.gz

neighbor      2.5 bin
neigh_modify  every 10 delay 0 check no

thermo        1000
thermo_style  custom step temp press etotal density
dump          traj all custom 5000 ${basename}.lammpstrj id type x y z
log           ${basename}.log

velocity        all create 3000 12345 mom yes rot yes dist gaussian

fix             1 all nve
fix             2 all temp/berendsen 4000 4000 500

timestep      0.1
run           10000

write_data    ${basename}.data

